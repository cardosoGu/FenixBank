{
    "openapi": "3.0.3",
    "info": {
        "title": "FenixBank API",
        "description": "API REST da **FenixBank**, uma plataforma bancária digital que oferece serviços de autenticação, gerenciamento de conta, transações financeiras e integração com Pix.\n\n## Autenticação\nA maioria dos endpoints requer um token JWT enviado no header `Authorization: Bearer <token>`.\nO token é obtido ao fazer login via `POST /api/auth/login`.\n\n## Fluxo básico\n1. Crie uma conta via `POST /api/auth/register`\n2. Faça login via `POST /api/auth/login` e guarde o token retornado\n3. Use o token no header `Authorization` para acessar os demais endpoints",
        "version": "1.0.0",
        "contact": {
            "name": "FenixBank"
        }
    },
    "servers": [
        {
            "url": "/",
            "description": "Servidor padrão"
        }
    ],
    "tags": [
        {
            "name": "Auth",
            "description": "Registro, login, sessões e perfil do usuário"
        },
        {
            "name": "Bank - Account",
            "description": "Informações da conta bancária"
        },
        {
            "name": "Bank - Transactions",
            "description": "Consulta de transações"
        },
        {
            "name": "Bank - Operations",
            "description": "Depósito, saque e transferência via Pix"
        },
        {
            "name": "Bank - Pix Keys",
            "description": "Gerenciamento de chaves Pix"
        }
    ],
    "components": {
        "securitySchemes": {
            "BearerAuth": {
                "type": "http",
                "scheme": "bearer",
                "bearerFormat": "JWT"
            }
        },
        "schemas": {
            "RegisterRequest": {
                "type": "object",
                "required": [
                    "name",
                    "email",
                    "cpf",
                    "password"
                ],
                "properties": {
                    "name": {
                        "type": "string",
                        "example": "Maria Silva"
                    },
                    "email": {
                        "type": "string",
                        "format": "email",
                        "example": "maria@fenixbank.com"
                    },
                    "cpf": {
                        "type": "string",
                        "example": "181.990.300-11"
                    },
                    "password": {
                        "type": "string",
                        "format": "password",
                        "example": "StrongPass123"
                    },
                    "pixKeys": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        },
                        "example": [
                            "maria@fenixbank.com"
                        ]
                    },
                    "balance": {
                        "type": "number",
                        "format": "float",
                        "description": "Saldo inicial da conta (opcional)",
                        "example": 250
                    }
                }
            },
            "LoginRequest": {
                "type": "object",
                "required": [
                    "email",
                    "password"
                ],
                "properties": {
                    "email": {
                        "type": "string",
                        "format": "email",
                        "example": "maria@fenixbank.com"
                    },
                    "password": {
                        "type": "string",
                        "format": "password",
                        "example": "StrongPass123"
                    }
                }
            },
            "AddPixKeyRequest": {
                "type": "object",
                "required": [
                    "newPixKey"
                ],
                "properties": {
                    "newPixKey": {
                        "type": "string",
                        "example": "maria.new@fenixbank.com"
                    }
                }
            },
            "AmountRequest": {
                "type": "object",
                "required": [
                    "amount"
                ],
                "properties": {
                    "amount": {
                        "type": "number",
                        "format": "float",
                        "example": 100
                    }
                }
            },
            "TransferRequest": {
                "type": "object",
                "required": [
                    "pixKey",
                    "amount"
                ],
                "properties": {
                    "pixKey": {
                        "type": "string",
                        "description": "Chave Pix do destinatário",
                        "example": "11999999999"
                    },
                    "amount": {
                        "type": "number",
                        "format": "float",
                        "example": 50
                    }
                }
            },
            "ErrorResponse": {
                "type": "object",
                "properties": {
                    "message": {
                        "type": "string",
                        "example": "Mensagem de erro descritiva"
                    }
                }
            }
        }
    },
    "security": [
        {
            "BearerAuth": []
        }
    ],
    "paths": {
        "/api/auth/register": {
            "post": {
                "tags": [
                    "Auth"
                ],
                "summary": "Registrar novo usuário",
                "description": "Cria uma nova conta de usuário na plataforma. Não requer autenticação prévia.",
                "security": [],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/RegisterRequest"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Usuário criado com sucesso",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "message": {
                                            "type": "string",
                                            "example": "User created successfully"
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Payload inválido ou e-mail já cadastrado",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Usuário já está logado",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/auth/login": {
            "post": {
                "tags": [
                    "Auth"
                ],
                "summary": "Realizar login",
                "description": "Autentica o usuário e retorna um token JWT para uso nas demais requisições.",
                "security": [],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/LoginRequest"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Login realizado com sucesso",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "token": {
                                            "type": "string",
                                            "description": "Token JWT de autenticação",
                                            "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Credenciais inválidas ou payload incorreto",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Usuário já está logado",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/auth/sessions": {
            "get": {
                "tags": [
                    "Auth"
                ],
                "summary": "Listar sessões ativas",
                "description": "Retorna todas as sessões ativas do usuário autenticado.",
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Sessões recuperadas com sucesso",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "sessions": {
                                            "type": "array",
                                            "items": {
                                                "type": "object",
                                                "properties": {
                                                    "id": {
                                                        "type": "string"
                                                    },
                                                    "createdAt": {
                                                        "type": "string",
                                                        "format": "date-time"
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Token ausente ou inválido",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/auth/logout": {
            "post": {
                "tags": [
                    "Auth"
                ],
                "summary": "Encerrar sessão atual",
                "description": "Invalida o token da sessão atual do usuário.",
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Sessão atual encerrada com sucesso",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "message": {
                                            "type": "string",
                                            "example": "Current session closed successfully"
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Login necessário",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/auth/logoutAll": {
            "post": {
                "tags": [
                    "Auth"
                ],
                "summary": "Encerrar todas as sessões",
                "description": "Invalida todos os tokens ativos do usuário em todos os dispositivos.",
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Todas as sessões encerradas com sucesso",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "message": {
                                            "type": "string",
                                            "example": "All sessions closed successfully"
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Login necessário",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/auth/refresh": {
            "put": {
                "tags": [
                    "Auth"
                ],
                "summary": "Renovar token da sessão atual",
                "description": "Gera um novo token JWT para a sessão atual, sem precisar fazer login novamente.",
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Token renovado com sucesso",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "token": {
                                            "type": "string",
                                            "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Login necessário",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/auth/me": {
            "get": {
                "tags": [
                    "Auth"
                ],
                "summary": "Obter perfil do usuário autenticado",
                "description": "Retorna os dados do perfil do usuário atualmente autenticado.",
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Perfil retornado com sucesso",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "id": {
                                            "type": "string"
                                        },
                                        "name": {
                                            "type": "string",
                                            "example": "Maria Silva"
                                        },
                                        "email": {
                                            "type": "string",
                                            "format": "email",
                                            "example": "maria@fenixbank.com"
                                        },
                                        "cpf": {
                                            "type": "string",
                                            "example": "181.990.300-11"
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Login necessário",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/bank/account": {
            "get": {
                "tags": [
                    "Bank - Account"
                ],
                "summary": "Obter informações da conta",
                "description": "Retorna os dados da conta bancária do usuário autenticado, incluindo saldo e chaves Pix.",
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Informações da conta retornadas com sucesso",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "accountId": {
                                            "type": "string"
                                        },
                                        "balance": {
                                            "type": "number",
                                            "format": "float",
                                            "example": 250.00
                                        },
                                        "pixKeys": {
                                            "type": "array",
                                            "items": {
                                                "type": "string"
                                            },
                                            "example": [
                                                "maria@fenixbank.com"
                                            ]
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Falha ao recuperar informações da conta",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Login necessário",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/bank/transactions": {
            "get": {
                "tags": [
                    "Bank - Transactions"
                ],
                "summary": "Listar transações do usuário",
                "description": "Retorna o histórico de transações da conta do usuário autenticado.",
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Transações retornadas com sucesso",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "transactions": {
                                            "type": "array",
                                            "items": {
                                                "type": "object",
                                                "properties": {
                                                    "id": {
                                                        "type": "string"
                                                    },
                                                    "type": {
                                                        "type": "string",
                                                        "enum": [
                                                            "deposit",
                                                            "withdraw",
                                                            "transfer"
                                                        ]
                                                    },
                                                    "amount": {
                                                        "type": "number",
                                                        "format": "float"
                                                    },
                                                    "createdAt": {
                                                        "type": "string",
                                                        "format": "date-time"
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Login necessário",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/bank/transactions/{id}": {
            "get": {
                "tags": [
                    "Bank - Transactions"
                ],
                "summary": "Obter transação por ID",
                "description": "Retorna os detalhes de uma transação específica pelo seu identificador. O usuário só pode consultar suas próprias transações.",
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "description": "ID único da transação",
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Transação retornada com sucesso",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "id": {
                                            "type": "string"
                                        },
                                        "type": {
                                            "type": "string",
                                            "enum": [
                                                "deposit",
                                                "withdraw",
                                                "transfer"
                                            ]
                                        },
                                        "amount": {
                                            "type": "number",
                                            "format": "float"
                                        },
                                        "createdAt": {
                                            "type": "string",
                                            "format": "date-time"
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Transação não encontrada ou sem permissão",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Login necessário",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/bank/deposit": {
            "post": {
                "tags": [
                    "Bank - Operations"
                ],
                "summary": "Realizar depósito",
                "description": "Deposita um valor na conta do usuário autenticado.\n**Limite:** O valor máximo por depósito é de **R$ 500,00**.",
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/AmountRequest"
                            },
                            "example": {
                                "amount": 100
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Depósito realizado com sucesso",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "message": {
                                            "type": "string",
                                            "example": "Deposit completed successfully"
                                        },
                                        "balance": {
                                            "type": "number",
                                            "format": "float"
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Payload inválido ou valor acima do limite de R$ 500,00",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Login necessário",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/bank/withdraw": {
            "post": {
                "tags": [
                    "Bank - Operations"
                ],
                "summary": "Realizar saque",
                "description": "Saca um valor da conta do usuário autenticado. O saldo deve ser suficiente para cobrir o valor solicitado.",
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/AmountRequest"
                            },
                            "example": {
                                "amount": 40
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Saque realizado com sucesso",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "message": {
                                            "type": "string",
                                            "example": "Withdraw completed successfully"
                                        },
                                        "balance": {
                                            "type": "number",
                                            "format": "float"
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Payload inválido ou saldo insuficiente",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Login necessário",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/bank/transfer": {
            "post": {
                "tags": [
                    "Bank - Operations"
                ],
                "summary": "Realizar transferência via Pix",
                "description": "Transfere um valor para outro usuário utilizando sua chave Pix.\n- O remetente não pode transferir para si mesmo.\n- O saldo deve ser suficiente para cobrir o valor.",
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/TransferRequest"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Transferência realizada com sucesso",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "message": {
                                            "type": "string",
                                            "example": "Transfer completed successfully"
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Payload inválido ou destinatário não encontrado",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Login necessário",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Não é possível transferir para si mesmo",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/bank/pixKey": {
            "post": {
                "tags": [
                    "Bank - Pix Keys"
                ],
                "summary": "Adicionar chave Pix",
                "description": "Adiciona uma nova chave Pix à conta do usuário autenticado.",
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/AddPixKeyRequest"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Chave Pix adicionada com sucesso",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "message": {
                                            "type": "string",
                                            "example": "PIX key added successfully"
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Payload inválido ou chave Pix já existe",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                }
                            }
                        }
                    },
